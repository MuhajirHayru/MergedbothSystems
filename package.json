{
  "name": "greenpath-systems",
  "private": true,
  "version": "1.0.0",
  "description": "Green Path marketplace frontend (greenpath-farm-to-market-ai) and the existing Django API and DriverApp.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "node scripts/dev.mjs --frontend-only",
    "dev:backend": "node scripts/dev.mjs --backend-only",
    "dev:driver": "node scripts/dev.mjs --driver-only",
    "dev:all": "node scripts/dev.mjs --all",
    "build": "npm --prefix greenpath-farm-to-market-ai run build",
    "typecheck": "npm --prefix greenpath-farm-to-market-ai run lint"
  }
}
