# Normalize line endings on checkin: convert CRLF -> LF when committing,
# and check out native line endings per platform.
* text=auto

# Source files always use LF in the repository (cross-platform safe)
*.py   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.svg  text eol=lf
*.ini  text eol=lf

# Windows-only shell scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary files must never be line-ending converted
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.gif  binary
*.pdf  binary
*.docx binary
*.doc  binary
*.zip  binary
*.sqlite3 binary
*.woff  binary
*.woff2 binary
