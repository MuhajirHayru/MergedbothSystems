# Password recovery email (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Green Path <no-reply@greenpath.et>

# Password recovery SMS (Africa's Talking). Keep API keys in deployment secrets.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_TIMEOUT_SECONDS=10

# Public origin used in password reset links.
FRONTEND_BASE_URL=http://localhost:3000

# DriverApp hand-off. The Marketplace exchanges its driver token for a DriverApp
# browser session and mirrors rotated access tokens back into that session.
NEXT_PUBLIC_DRIVER_APP_URL=http://localhost:3001
NEXT_PUBLIC_DRIVER_APP_API_URL=http://localhost:8001/api

# Copy this to backend/.env. Use the IPv4 literal for local services: on Windows
# "localhost" resolves to IPv6 (::1) first, and a dev server bound to 127.0.0.1
# makes every call wait for the IPv6 connect attempt to time out (~2s per call).
GREENPATH_DRIVER_INTEGRATION_BASE_URL=http://127.0.0.1:8001
GREENPATH_DRIVER_INTEGRATION_SECRET=replace-with-a-random-64-character-shared-secret

# Copy the assistant settings to backend/.env. Never expose the key through NEXT_PUBLIC_*.
GROQ_API_KEY=
# Active tool-calling model verified from the Groq Models API.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TIMEOUT_SECONDS=30
