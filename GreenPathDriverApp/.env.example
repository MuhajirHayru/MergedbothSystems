DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
DATABASE_URL=sqlite:///db.sqlite3
FRONTEND_BASE_URL=http://localhost:3001
DRIVER_DOCUMENT_MAX_BYTES=10485760
SHIPMENT_EVIDENCE_MAX_BYTES=10485760
SHIPMENT_REQUIRE_PICKUP_EVIDENCE=true
SHIPMENT_REQUIRE_DELIVERY_EVIDENCE=true
DRIVER_LOCATION_MAX_ACCURACY_METERS=1000
DRIVER_LOCATION_MAX_AGE_SECONDS=120
DRIVER_LOCATION_FUTURE_SKEW_SECONDS=30
DRIVER_LOCATION_SESSION_TIMEOUT_SECONDS=120
DRIVER_LOCATION_STALE_AFTER_SECONDS=90
DRIVER_LOCATION_MAX_PAYLOAD_BYTES=2048
MARKETPLACE_INTEGRATION_ENABLED=false
MARKETPLACE_INTEGRATION_SECRET=replace-with-a-random-64-character-shared-secret
MARKETPLACE_INTEGRATION_MAX_BYTES=262144
MARKETPLACE_INTEGRATION_MAX_SKEW_SECONDS=300
# Use the IPv4 literal for local services. On Windows "localhost" resolves to
# IPv6 (::1) first, and a dev server bound to 127.0.0.1 makes every call wait
# for the IPv6 connect attempt to time out (~2s per request).
GREENPATH_MARKETPLACE_API_BASE_URL=http://127.0.0.1:8000
# Origins allowed to run the Marketplace session exchange. This is the
# Marketplace frontend origin, because the Marketplace browser page is what
# trades its driver access token for a DriverApp session.
MARKETPLACE_LOGIN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
DRIVER_DOCUMENT_TYPES=identity,driving_license,vehicle_registration
DRIVER_REQUIRED_DOCUMENT_TYPES=identity,driving_license,vehicle_registration
DRIVER_REQUIRED_APPLICATION_FIELDS=legal_full_name,license_number,license_expiry,vehicle_type,vehicle_registration,cargo_capacity_kg

# Grounded text and voice assistant. Leave GROQ_API_KEY empty to keep the
# assistant disabled; the backend then refuses assistant and transcription
# requests instead of calling an unconfigured provider.
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_AUDIO_BYTES=10485760

# Production account activation and recovery email (never commit real values):
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=replace-with-smtp-user
# EMAIL_HOST_PASSWORD=replace-with-smtp-secret
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=GreenPath <noreply@example.com>

# Optional private storage provider. FileSystemStorage is private by default.
# PRIVATE_DOCUMENT_ROOT=C:/private/greenpath-driver-documents
# PRIVATE_DOCUMENT_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
# PRIVATE_DOCUMENT_STORAGE_OPTIONS={}

# PostgreSQL example for production or shared development:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE